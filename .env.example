# Copie ce fichier en .env et renseigne tes clés.

# --- Anthropic (génération IA) ---
# ATTENTION (voir README) : pour une vraie mise en prod, ne mets JAMAIS
# la clé API directement dans l'appli mobile. Utilise un petit backend
# relais. Ce mode direct sert uniquement à tester le MVP rapidement.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# --- Supabase (comptes + base de données + stockage photos) ---
# Récupère ces valeurs dans ton projet Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Connexions réseaux sociaux (optionnel, voir README section OAuth) ---
# Ces identifiants viennent des consoles développeurs de chaque plateforme.
# Tant qu'ils ne sont pas remplis, les boutons de connexion affichent
# "à configurer" au lieu de planter.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=

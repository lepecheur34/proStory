# Copie ce fichier en .env et renseigne tes clés.

# --- OpenAI (génération IA) ---
# ATTENTION (voir README) : pour une vraie mise en prod, ne mets JAMAIS
# la clé API directement dans l'appli mobile. Utilise un petit backend
# relais. Ce mode direct sert uniquement à tester le MVP rapidement.
EXPO_PUBLIC_OPENAI_API_KEY=

# --- Supabase (comptes + base de données + stockage photos) ---
# Récupère ces valeurs dans ton projet Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=


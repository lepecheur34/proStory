{
  "expo": {
    "name": "ProStory",
    "slug": "prostory",
    "scheme": "prostory",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.prostory.mvp",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin de la caméra pour photographier vos réalisations.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à vos photos pour illustrer vos réalisations."
      }
    },
    "android": {
      "package": "com.prostory.mvp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1B4B"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#1A1B4B",
          "imageWidth": 200
        }
      ],
      "expo-mail-composer",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "bb66ed71-9b3a-4a1a-91ff-d6cc8b828afc"
      }
    }
  }
}
